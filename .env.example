# URL do sistema externo da Área do Segurado (holerite, protocolos, etc.)
SEGURADO_SYSTEM_URL=
SEGURADO_SYSTEM_NAME=Sistema do Segurado

# Prefixo atrás do reverse proxy (ex.: /iprevicon). Vazio = raiz.
BASE_PATH=

# Porta no host (bind em 127.0.0.1 no compose)
HOST_PORT=3000

# Painel /admin — obrigatório em produção
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria
