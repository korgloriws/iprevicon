# URL do sistema externo da Área do Segurado (holerite, protocolos, etc.)
SEGURADO_SYSTEM_URL=
SEGURADO_SYSTEM_NAME=Sistema do Segurado

# Prefixo atrás do reverse proxy (ex.: /iprevicon). Vazio = raiz.
BASE_PATH=

# Porta no host (bind em 127.0.0.1 no compose)
HOST_PORT=3000

# Painel /admin — obrigatório em produção
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria

# URL pública do site (QR Code / WhatsApp da pesquisa)
SITE_URL=http://localhost:3000

# WhatsApp da Ouvidoria (DDI+DDD+número, só dígitos)
WHATSAPP_OUVIDORIA=

# E-mail da Ouvidoria + SMTP (opcional — se vazio, só grava no SQLite)
OUVIDORIA_EMAIL=ouvidoria@iprevicon.contagem.mg.gov.br
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
